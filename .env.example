# Copy this file to .env.local and fill in your Supabase project's values.
# Both are the PUBLIC client credentials (safe to ship in the app — security is
# enforced by Row Level Security). Never put the service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# USDA FoodData Central (barcode + name fallback). Free key: https://fdc.nal.usda.gov/api-key-signup
# Optional — falls back to the rate-limited DEMO_KEY if unset.
EXPO_PUBLIC_USDA_API_KEY=DEMO_KEY

# PostHog analytics. Read at build time by app.config.js and exposed to the app
# via expo-constants extras (see src/config/posthog.ts). Set these in your build
# environment (e.g. EAS Build secrets or your shell) before running a production
# build — app.config.js bakes them into the bundle, so they must be present when
# the build runs. The token is the project's public client key (safe to ship).
POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
POSTHOG_HOST=https://us.i.posthog.com
